import os, math
from collections import Counter
import numpy as np
import pandas as pd

from sklearn.model_selection import GroupKFold
from sklearn.ensemble import HistGradientBoostingClassifier


# ----------------------------
# label: "ab/cd", "a/b/cd", "a/b/c/d", "abcd"
# -> mask(0..7), cuts at positions 1,2,3
# ----------------------------
def label_to_mask_len4(label: str) -> int:
    parts = label.strip().split("/")
    lens = [len(p) for p in parts if p != ""]
    if sum(lens) != 4 or any(l <= 0 for l in lens):
        raise ValueError(f"bad label: {label}")

    acc, cuts = 0, set()
    for l in lens[:-1]:
        acc += l
        cuts.add(acc)  # 1..3

    b1 = 1 if 1 in cuts else 0
    b2 = 1 if 2 in cuts else 0
    b3 = 1 if 3 in cuts else 0
    return (b1 << 2) | (b2 << 1) | b3


def mask_to_segments(token: str, mask: int):
    cuts = []
    if (mask >> 2) & 1: cuts.append(1)
    if (mask >> 1) & 1: cuts.append(2)
    if (mask >> 0) & 1: cuts.append(3)
    out, prev = [], 0
    for c in cuts:
        out.append(token[prev:c]); prev = c
    out.append(token[prev:4])
    return out


def H(counter: Counter) -> float:
    n = sum(counter.values())
    if n == 0: return 0.0
    ent = 0.0
    for c in counter.values():
        p = c / n
        ent -= p * math.log(p + 1e-12)
    return ent


def var_prob(counter: Counter) -> float:
    n = sum(counter.values())
    if n == 0: return 0.0
    ps = np.array([c / n for c in counter.values()], float)
    return float((ps**2).mean() - ps.mean()**2)


def mi_pairs(pairs) -> float:
    joint = Counter(pairs)
    n = sum(joint.values())
    if n == 0: return 0.0
    cx, cy = Counter(), Counter()
    for (x, y), c in joint.items():
        cx[x] += c; cy[y] += c
    mi = 0.0
    for (x, y), c in joint.items():
        pxy = c / n
        px = cx[x] / n
        py = cy[y] / n
        mi += pxy * math.log((pxy / (px * py)) + 1e-12)
    return mi


def featurize(tokens4, mask: int):
    segs_all = [mask_to_segments(t, mask) for t in tokens4]
    m = len(segs_all[0])  # 1~4

    pos_cnt = [Counter() for _ in range(m)]
    for segs in segs_all:
        for i, s in enumerate(segs):
            pos_cnt[i][s] += 1

    ent = [H(c) for c in pos_cnt]
    var = [var_prob(c) for c in pos_cnt]

    # 인접 세그먼트 MI 평균
    mi = 0.0
    if m >= 2:
        mi = float(np.mean([mi_pairs([(segs[i], segs[i+1]) for segs in segs_all]) for i in range(m-1)]))

    return {
        "mask": mask,
        "b1": (mask >> 2) & 1, "b2": (mask >> 1) & 1, "b3": (mask >> 0) & 1,
        "num_segs": m,
        "ent_sum": float(sum(ent)),
        "var_sum": float(sum(var)),
        "mi_mean": mi,
        "n_tokens": len(tokens4),
    }


def load_folder(folder="ct_data"):
    msgs, y = [], []
    for fn in sorted(os.listdir(folder)):
        if not fn.endswith(".txt"): 
            continue
        path = os.path.join(folder, fn)
        with open(path, "r", encoding="utf-8") as f:
            line1 = f.readline().strip()
            line2 = f.readline().strip()

        tokens = [t for t in line1.split() if len(t) == 4]
        if not tokens:
            continue

        mask = label_to_mask_len4(line2)
        msgs.append(tokens)
        y.append(mask)
    return msgs, y


def build_df(long_tokens_list, y_masks):
    rows = []
    for gid, (tokens4, y_mask) in enumerate(zip(long_tokens_list, y_masks)):
        for mask in range(8):
            r = featurize(tokens4, mask)
            r.update({"group_id": gid, "y_true": y_mask})
            rows.append(r)
    return pd.DataFrame(rows)


def top1_acc(df, scores):
    tmp = df[["group_id", "mask", "y_true"]].copy()
    tmp["score"] = scores
    chosen = tmp.sort_values(["group_id", "score"], ascending=[True, False]).groupby("group_id").head(1)
    return float((chosen["mask"] == chosen["y_true"]).mean())


def main():
    long_msgs, y_masks = load_folder("ct_data")
    print("loaded files(len4 tokens):", len(long_msgs))

    df = build_df(long_msgs, y_masks)
    feat = ["b1","b2","b3","num_segs","ent_sum","var_sum","mi_mean","n_tokens"]

    X = df[feat].to_numpy()
    groups = df["group_id"].to_numpy()
    y = df["y_true"].to_numpy()  # 멀티클래스(0..7), 후보행마다 동일

    model = HistGradientBoostingClassifier(max_depth=3, learning_rate=0.05, max_iter=600, random_state=42)
    gkf = GroupKFold(n_splits=5)

    accs = []
    for i, (tr, te) in enumerate(gkf.split(X, y, groups), 1):
        model.fit(X[tr], y[tr])
        proba = model.predict_proba(X[te])  # (rows, 8)
        te_df = df.iloc[te]
        masks = te_df["mask"].to_numpy()
        scores = proba[np.arange(len(te_df)), masks]  # 후보 mask 확률을 점수로
        acc = top1_acc(te_df, scores)
        accs.append(acc)
        print(f"fold {i}: top1={acc:.4f}")

    print("mean top1:", float(np.mean(accs)))


if __name__ == "__main__":
    main()
